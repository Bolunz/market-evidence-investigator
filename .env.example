# Copy to .env and fill in. .env is git-ignored. Never commit a real key.
ANTHROPIC_API_KEY=

# Model IDs (override if your account uses different ones)
MEI_MODEL_MAIN=claude-sonnet-5-5
MEI_MODEL_SMALL=claude-haiku-5-5

# Hard cap on LLM calls per investigation run (cost guard)
MEI_MAX_LLM_CALLS=60
